{
  "template": "portfolio",
  "version": "1.0.0",
  "fields": {
    "name": { "type": "string", "required": true, "description": "设计师姓名", "placeholder": "{{NAME}}" },
    "title": { "type": "string", "required": false, "description": "职位头衔", "placeholder": "{{TITLE}}" },
    "subtitle": { "type": "string", "required": false, "description": "副标题描述" },
    "projects": {
      "type": "array",
      "required": true,
      "description": "作品项目列表",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "fields": {
          "title": { "type": "string", "required": true, "example": "科技公司全案设计" },
          "category": { "type": "string", "required": true, "example": "品牌设计" },
          "description": { "type": "string", "required": false, "example": "从 Logo 到完整的品牌视觉体系..." },
          "image_url": { "type": "string", "required": false, "description": "项目封面图片" },
          "icon": { "type": "string", "required": false, "example": "🎨" },
          "size": { "type": "string", "required": false, "enum": ["normal", "wide", "tall"], "default": "normal" }
        }
      }
    },
    "featured": {
      "type": "object",
      "required": false,
      "description": "精选项目详情",
      "fields": {
        "title": { "type": "string", "example": "智慧城市数据可视化平台" },
        "description": { "type": "string", "example": "为某一线城市打造的..." },
        "tags": { "type": "array", "items": { "type": "string" }, "example": ["数据可视化", "D3.js"] },
        "image_url": { "type": "string" }
      }
    },
    "services": {
      "type": "array",
      "required": false,
      "description": "提供的服务列表",
      "items": {
        "type": "object",
        "fields": {
          "title": { "type": "string", "required": true, "example": "UI/UX 设计" },
          "description": { "type": "string", "required": true, "example": "以用户为中心的界面设计..." },
          "icon": { "type": "string", "required": false, "example": "🎨" }
        }
      }
    },
    "contact": {
      "type": "object",
      "required": true,
      "fields": {
        "email": { "type": "string", "example": "hello@example.com" },
        "available": { "type": "boolean", "default": true, "description": "是否可接项目" },
        "socials": {
          "type": "array",
          "items": {
            "type": "object",
            "fields": {
              "name": { "type": "string", "example": "GitHub" },
              "url": { "type": "string", "example": "https://github.com" },
              "icon": { "type": "string", "example": "💻" }
            }
          }
        }
      }
    }
  }
}
