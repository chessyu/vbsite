# VBSite 环境变量示例
#
# ⚠️ 重要：VITE_ 前缀的变量会被打进浏览器 bundle，严禁存放任何密钥。
# 所有服务端密钥只放 Cloudflare Pages Dashboard（Settings → Environment variables）
# 或本地 .dev.vars（已被 .gitignore 忽略）。
#

# ---------- Cloudflare Pages Functions（服务端） ----------

# 管理员登录密码（必填）
ADMIN_PASSWORD=

# HMAC 签名密钥（必填，openssl rand -base64 32 生成）
ADMIN_TOKEN_SECRET=

# 编辑链接有效期（小时，默认 24）
EDIT_LINK_TTL_HOURS=24

# 管理员会话时长（小时，默认 12）
ADMIN_SESSION_TTL_HOURS=12

# GitHub fine-grained PAT（必填，仅授予目标仓库 Contents: Read and write）
GITHUB_PAT=

# 目标仓库，如 chessyu/vbsite（必填）
GITHUB_REPO=

# 提交目标分支（默认 main，须等于 Pages 生产分支，push 即触发构建）
GITHUB_BRANCH=main

# 上传资源单文件上限 MB（默认 10）
MAX_ASSET_MB=10

# ---------- 二期：LLM（OpenAI 兼容接口） ----------
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
